"File: LAB000_BoardBringup.csolution.yml" = """
# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  output-dirs:
    tmpdir: build
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  target-types:
    - type: main
      device: STM32C542RCT6
  projects:
    - project: project/LAB000_BoardBringup.cproject.yml
  packs:
    - pack: STMicroelectronics::stm32c5xx_dfp@2.1.0
"""
