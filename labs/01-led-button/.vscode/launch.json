{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "01_LED_Button: ST-LINK Debug",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}/01_LED_Button_cmake",
      "preLaunchTask": "01_LED_Button: Build",
      "preBuild": "",
      "runEntry": "main",
      "deviceName": "STM32C542RCT6",
      "deviceCore": "Cortex-M33",
      "gdb": "${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gdb.exe",
      "serverExe": "ST-LINK_gdbserver.exe",
      "serverCubeProgPath": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin",
      "serverInterface": "SWD",
      "serverInterfaceFrequency": "1000",
      "serverReset": "Connect under reset",
      "serverVerify": true,
      "serverApID": "1",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/01_LED_Button_cmake/build/debug_GCC_NUCLEO-C542RC/01_LED_Button.elf"
        }
      ],
      "serverCwd": "${env:LOCALAPPDATA}/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin"
    }
  ]
}
