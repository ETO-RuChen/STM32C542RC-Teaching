{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "01_LED_Button: Build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../Tools/STM32.ps1",
                "-Action",
                "Build",
                "-Project",
                "01_LED_Button"
            ],
            "options": {
                "cwd": "${workspaceFolder}/01_LED_Button_cmake"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
